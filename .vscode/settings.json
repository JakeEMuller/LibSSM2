{
    "cmake.useCMakePresets": "always",
    "cmake.sourceDirectory": "${workspaceFolder}",

    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.cppStandard": "c++17",

    "files.associations": {
        "*.h": "cpp",
        "CMakeLists.txt": "cmake",
        "*.cmake": "cmake"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "search.exclude": {
        "**/build": true
    },

    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    }
}
