// Copy this file to .vscode/settings.json and edit the clang-format path to
// wherever your clang-format binary lives. settings.json is gitignored.
{
    "cmake.useCMakePresets": "always",
    "cmake.sourceDirectory": "${workspaceFolder}",

    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.cppStandard": "c++17",

    "files.associations": {
        "*.h": "cpp",
        "CMakeLists.txt": "cmake",
        "*.cmake": "cmake"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "search.exclude": {
        "**/build": true
    },

    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },

    // EDIT THIS PATH to point at your clang-format binary.
    // Example: "C:/Program Files/LLVM/bin/clang-format.exe"
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_path": "${workspaceFolder}/../Clang-format-14.0.1/clang-format.exe"
}
